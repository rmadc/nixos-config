// Checks for pull requests and for main. See README.md.
// Nothing here deploys.
pipeline {
  agent { label 'practice' }

  stages {
    stage('Checks') {
      parallel {
        stage('Check scripts') {
          steps {
            // Every shell script tracked by Git. If none is found, ShellCheck
            // gets no files and fails, so the check cannot pass without checking.
            sh "git ls-files -z -- '*.sh' | xargs -0 shellcheck"
          }
        }

        stage('Lint Python') {
          steps {
            sh 'ruff check .'
          }
        }

        stage('Unit tests') {
          steps {
            sh '''
              rm -f results.xml
              pytest -p no:cacheprovider --junitxml=results.xml containers/telegram/tests || [ "$?" -eq 1 ]
            '''
          }
          post {
            always {
              junit 'results.xml'
            }
          }
        }
      }
    }

    stage('Package') {
      when { branch 'main' }
      steps {
        sh '''
          mkdir -p dist
          rm -f dist/*
          name="telegram-jobs-$(git rev-parse --short HEAD).tar.gz"

          # Package files as committed, without the tests.
          git archive --format=tar.gz --output="dist/$name" HEAD -- containers/telegram ':(exclude)containers/telegram/tests'

          # Record the source commit and the hashes.
          git rev-parse HEAD > dist/COMMIT
          git ls-files -z -- containers/telegram ':(exclude)containers/telegram/tests' | xargs -0 sha256sum > dist/FILES.sha256
          (cd dist && sha256sum "$name" > "$name.sha256")
        '''
        archiveArtifacts artifacts: 'dist/*', fingerprint: true
      }
    }

    stage('Approve') {
      when { branch 'main' }
      // A waiting build keeps its executor, so do not wait forever.
      options { timeout(time: 10, unit: 'MINUTES') }
      steps {
        input message: 'Simulate deployment of this package?', ok: 'Deploy'
      }
    }

    stage('Deploy (simulation)') {
      when { branch 'main' }
      steps {
        sh '''
          # A folder in the workspace stands in for the target host.
          rm -rf fake-target
          mkdir fake-target
          (cd dist && sha256sum -c ./*.tar.gz.sha256)
          tar -xzf dist/*.tar.gz -C fake-target
          (cd fake-target && sha256sum --quiet -c ../dist/FILES.sha256)
          cp dist/COMMIT fake-target/COMMIT
          echo "Simulated deployment of commit $(cat fake-target/COMMIT)"
        '''
      }
    }
  }

  post {
    success {
      echo 'Pipeline passed.'
    }
    aborted {
      echo 'Pipeline was aborted before finishing.'
    }
    failure {
      echo 'Pipeline failed.'
    }
  }
}
