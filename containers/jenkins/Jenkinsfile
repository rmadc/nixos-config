// Checks for pull requests and for main. See README.md.
// Nothing here deploys.
pipeline {
  agent { label 'practice' }

  stages {
    stage('Check scripts') {
      steps {
        // Every shell script tracked by Git. If none is found, ShellCheck
        // gets no files and fails, so the check cannot pass without checking.
        sh "git ls-files -z -- '*.sh' | xargs -0 shellcheck"
      }
    }
  }
}
