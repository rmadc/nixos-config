// Practice pipeline for the Jenkins lab. See README.md.
pipeline {
  agent { label 'practice' }

  stages {
    stage('Build') {
      steps {
        sh 'echo "hello" > message.txt'
      }
    }
    stage('Test') {
      steps {
        sh 'grep goodbye message.txt'
      }
    }
    stage('Secret') {
      environment {
        TOKEN = credentials('practice-token')
      }
      steps {
        sh 'echo "Token is $TOKEN"'
      }
    }
   // stage('Approve') {
   //   when { branch 'main' }
   //   steps {
   //     input message: 'Continue to Report?', ok: 'Continue'
   //   }
   // }

    stage('Report') {
      when { branch 'main' }
      steps {
        sh 'cat message.txt'
        archiveArtifacts artifacts: 'message.txt'
      }
    }    
  }

  post {
    success {
      echo 'All goody good!'
    }
    failure {
      echo 'Something failed'
    }
    always {
      echo 'This runs either way'
    }
  }
}
