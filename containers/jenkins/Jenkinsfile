// Practice pipeline for the Jenkins lab. See README.md.
pipeline {
  agent any
parameters {
  string(name: 'GREETING', defaultValue: 'hello', description: 'Text to write')
}

  stages {
    stage('Build') {
      steps {
        sh 'echo "$GREETING" > message.txt'
      }
    }
    stage('Test') {
      steps {
        sh 'grep hello message.txt'
      }
    }
    stage('Secret') {
      environment {
        TOKEN = credentials('practice-token')
      }
      steps {
        sh 'echo "Token is $TOKEN"'
      }
    }
    stage('Approve') {
      steps {
        input message: 'Continue to Report?', ok: 'Continue'
    }
    }
    stage('Report') {
      steps {
        sh 'cat message.txt'
        archiveArtifacts artifacts: 'message.txt'
      }
    }
  }

  post {
    success {
      echo 'All stages passed'
    }
    failure {
      echo 'Something failed'
    }
    always {
      echo 'This runs either way'
    }
  }
}
