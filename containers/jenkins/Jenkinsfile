// Practice pipeline for the Jenkins lab. See README.md.
pipeline {
  agent { label 'practice' }

  stages {
    stage('Build') {
      steps {
        sh 'echo "hello" > message.txt'
      }
    }
    stage('Test') {
      steps {
        sh '''
          if grep hello message.txt; then
            result=""
          else
            result="<failure message='hello not found'/>"
          fi
          echo "<testsuite name='lab'><testcase classname='lab' name='message_has_hello'>$result</testcase></testsuite>" > results.xml
        '''
      }
      post {
        always {
          junit 'results.xml'
        }
      }
    }
    stage('Secret') {
      environment {
        TOKEN = credentials('practice-token')
      }
      steps {
        sh 'echo "Token is $TOKEN"'
      }
    }
   // stage('Approve') {
   //   when { branch 'main' }
   //   steps {
   //     input message: 'Continue to Report?', ok: 'Continue'
   //   }
   // }

    stage('Report') {
      when { branch 'main' }
      steps {
        sh 'cat message.txt'
        archiveArtifacts artifacts: 'message.txt'
      }
    }    
  }

  post {
    success {
      echo 'All goody good!'
    }
    failure {
      echo 'Something failed'
    }
    always {
      echo 'This runs either way'
    }
  }
}
